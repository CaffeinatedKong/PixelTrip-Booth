# PixelArt Trip Planner — frontend environment example
#
# Copy this file to `frontend/.env.local` and fill in local values.
# Only this .env.example (placeholder values) is committed to version control.
# Never commit a real .env / .env.local file.

# --- Service layer selection -------------------------------------------------
# Selects which service implementations the UI runs against. This is the single
# switch point (see src/services). Exact, case-sensitive: "mock" or "real".
# Unset/empty defaults to "mock" so the frontend runs with no backend.
NEXT_PUBLIC_SERVICE_MODE=mock

# --- Supabase (anon-key oriented placeholder; no network calls in Foundation) ---
# The frontend owns only the anon-key client. It MUST NEVER hold the Supabase
# service-role key — that belongs to the backend/service role only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# --- Backend API (FastAPI) base URL placeholder ------------------------------
# Used only when NEXT_PUBLIC_SERVICE_MODE=real. Placeholder until backend lands.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
